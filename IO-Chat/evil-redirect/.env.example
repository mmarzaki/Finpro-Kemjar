# URL halaman login I/O Chat yang asli.
# Dipakai sebagai tujuan default Open Redirect (dan bisa diganti lewat query string).
# Saat deploy, isi dengan domain frontend I/O Chat milikmu, contoh:
# NEXT_PUBLIC_IOCHAT_LOGIN_URL=https://io-chat.vercel.app
NEXT_PUBLIC_IOCHAT_LOGIN_URL=http://localhost:3000
